  "captions": [
    {
      "duration_frames": 120,
      "from_frame": 0,
      "text": "Your AI can draft the reply without making the promise."
    },
    {
      "duration_frames": 210,
      "from_frame": 120,
      "text": "Imagine a customer asking when something will arrive. Use a fictional request for the first test."
    },
    {
      "duration_frames": 210,
      "from_frame": 330,
      "text": "Give the assistant only approved facts and a clear instruction to flag anything it cannot confirm."
    },
    {
      "duration_frames": 210,
      "from_frame": 540,
      "text": "In this example, the draft promises tomorrow. Our approved information does not support that date."
    },
    {
      "duration_frames": 210,
      "from_frame": 750,
      "text": "The next step is a person checking the request, not the message going straight to the customer."
    },
    {
      "duration_frames": 180,
      "from_frame": 960,
      "text": "That person corrects the draft, confirms any promise, and decides whether to send it."
    },
    {
      "duration_frames": 180,
      "from_frame": 1140,
      "text": "Keep the boundary visible: prepare, review, then send. A missing fact returns to the process owner."
    },
    {
      "duration_frames": 180,
      "from_frame": 1320,
      "text": "Map one routine reply today. Mark the exact point where a human must decide."
    }
  ],
