# Скопируй в .env и заполни. Сам .env в репозиторий не попадает.
HIKER_KEY=
NOTION_TOKEN=
NOTION_CARDS_DB=
NOTION_PAGE=
NOTION_REELS_DB=
NOTION_ACCOUNTS_DB=

# --- необязательные провайдеры (engine/providers.py) --------------------------------
# Ни один из них не нужен для дефолтного пути (Hiker → local whisper → local ffmpeg →
# Remotion). Пустые/отсутствующие — нормальное состояние, python -m engine.providers
# просто покажет их NOT_CONFIGURED или DISABLED.

# Loore: платный резерв для транскрипции/медиа, НИКОГДА не требуется. Даже с заполненным
# ключом провайдер остаётся DISABLED, пока явно не выставлен LOORE_ENABLED=1.
LOORE_KEY=
# LOORE_ENABLED=1

# Supabase: хранилище объектов/файлов для будущих ассетов карточек (не используется
# сегодняшним пайплайном).
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Cloudflare R2: альтернативное/дополнительное объектное хранилище.
CLOUDFLARE_API_TOKEN=
CF_R2_BUCKET=

# OpenAI: генерация изображений (image_gen) для будущих карточек/раскадровок.
OPENAI_API_KEY=

# Higgsfield: генерация видео/брендовых ассетов (video_gen).
HIGGSFIELD_API_KEY=
# Cloudflare public preview base URL (optional; delivery role only, see docs/PRODUCTION_PIPELINE.md)
CF_PUBLIC_BASE_URL=
# Supabase Storage bucket for rendered videos (default m2-renders)
SUPABASE_BUCKET=
