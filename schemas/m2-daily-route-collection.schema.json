{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archflow.local/content-engine/m2-daily-route-collection.schema.json",
  "title": "M2DailyRouteCollection",
  "type": "object",
  "required": ["schema", "collection_id", "provider_mode", "routes", "selected_route_id", "selection_state"],
  "properties": {
    "schema": {"const": "m2.daily-route-collection.v1"},
    "collection_id": {"type": "string", "minLength": 1},
    "provider_mode": {"const": "disabled"},
    "routes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/route"}},
    "selected_route_id": {"type": "string", "minLength": 1},
    "selection_state": {"const": "OWNER_REVIEW_PENDING"}
  },
  "$defs": {
    "nonEmptyStrings": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "route": {
      "type": "object",
      "required": ["route_id", "topic", "source_ids", "evidence_ids", "claim_evidence_map", "audience", "job", "pain", "why_now", "market_context", "angle", "mechanisms", "prohibited_copy", "m2_contribution", "m2_proof", "strategic_placement", "production_complexity"],
      "properties": {
        "route_id": {"type": "string", "minLength": 1}, "title": {"type": "string"}, "topic": {"type": "string", "minLength": 1},
        "source_ids": {"$ref": "#/$defs/nonEmptyStrings"}, "evidence_ids": {"$ref": "#/$defs/nonEmptyStrings"},
        "claim_evidence_map": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nonEmptyStrings"}},
        "audience": {"type": "string", "minLength": 1}, "job": {"type": "string", "minLength": 1}, "pain": {"type": "string", "minLength": 1},
        "why_now": {"type": "string", "minLength": 1}, "market_context": {"type": "string", "minLength": 1}, "angle": {"type": "string", "minLength": 1},
        "mechanisms": {"$ref": "#/$defs/nonEmptyStrings"}, "prohibited_copy": {"$ref": "#/$defs/nonEmptyStrings"},
        "m2_contribution": {"type": "string", "minLength": 1}, "m2_proof": {"type": "string", "minLength": 1},
        "strategic_placement": {"type": "object", "required": ["90_day", "30_day", "7_day"], "additionalProperties": {"type": "string", "minLength": 1}},
        "production_complexity": {"type": "object", "required": ["class", "duration_seconds", "providers_required", "external_actions"]},
        "platforms": {"type": "array", "items": {"type": "string"}}, "success_metrics": {"type": "array", "items": {"type": "string"}}, "claim_label": {"enum": ["FACT", "INTERPRETATION", "HYPOTHESIS", "GAP"]}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
