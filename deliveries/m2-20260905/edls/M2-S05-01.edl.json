  "captions": [
    {
      "duration_frames": 120,
      "from_frame": 0,
      "text": "Your first AI project might fit on one sticky note."
    },
    {
      "duration_frames": 210,
      "from_frame": 120,
      "text": "Pick something your team repeats. For this example, turning weekly notes into a draft update."
    },
    {
      "duration_frames": 210,
      "from_frame": 330,
      "text": "Write down what goes in, what should come out, and who checks it."
    },
    {
      "duration_frames": 210,
      "from_frame": 540,
      "text": "Give AI the drafting step. Keep the decision about what to send with a person."
    },
    {
      "duration_frames": 210,
      "from_frame": 750,
      "text": "Now try one made-up example. Include a missing detail and see how the draft handles it."
    },
    {
      "duration_frames": 180,
      "from_frame": 960,
      "text": "If it guesses, change the instruction: mark the gap instead of filling it."
    },
    {
      "duration_frames": 180,
      "from_frame": 1140,
      "text": "That gives you a small test you can inspect before connecting real work."
    },
    {
      "duration_frames": 180,
      "from_frame": 1320,
      "text": "Take one repeated task. Name its input, its output, and the person responsible."
    }
  ],
