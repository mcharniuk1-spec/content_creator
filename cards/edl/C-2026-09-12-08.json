 "captions": [
  {
   "from_frame": 0,
   "duration_frames": 228,
   "text": "Same job, twice. This one is a paragraph of instructions. That one is six agents. Watch where each stops."
  },
  {
   "from_frame": 228,
   "duration_frames": 276,
   "text": "The task runs about five times a week. A quote, a summary, a reply. Whatever you build, somebody has to keep it running."
  },
  {
   "from_frame": 504,
   "duration_frames": 300,
   "text": "This is the paragraph. What the task is, what good looks like, three checks at the bottom. Anyone doing the job can read every line."
  },
  {
   "from_frame": 804,
   "duration_frames": 276,
   "text": "This is the other one. Six steps, four of them fine, and this one waiting on something nobody in the room can fix."
  },
  {
   "from_frame": 1080,
   "duration_frames": 492,
   "text": "We did the elaborate version to ourselves. A hundred and fifteen measurements across two hundred and sixty-eight videos. Not one reliably separated a strong reel from a weak one. What survived was a question we could have asked on day one."
  },
  {
   "from_frame": 1572,
   "duration_frames": 252,
   "text": "Three questions before you build. Who can change it. What happens when it is wrong. How long until it first runs."
  },
  {
   "from_frame": 1824,
   "duration_frames": 264,
   "text": "Write your task as one paragraph and run it by hand five times this week. Send this to whoever is scoping it."
  }
 ],
