{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archflow.local/content-engine/m2-studio-package.schema.json",
  "title": "M2ProviderNeutralStudioArtifact",
  "description": "Union contract for separately persisted provider-neutral Studio artifacts.",
  "oneOf": [
    {"$ref": "#/$defs/script"}, {"$ref": "#/$defs/shots"}, {"$ref": "#/$defs/assets"},
    {"$ref": "#/$defs/founder"}, {"$ref": "#/$defs/edit"}, {"$ref": "#/$defs/platform"}, {"$ref": "#/$defs/qc"}
  ],
  "$defs": {
    "script": {
      "type": "object",
      "required": ["schema", "script_id", "route_id", "version", "duration_ms", "hook_options", "chosen_hook", "segments", "full_script", "reading_speed_wpm", "cta", "title", "cover_text", "caption", "pinned_comment_strategy", "platform_adaptations", "claim_map", "on_screen_text", "approval_state"],
      "properties": {
        "schema": {"const": "m2.script-package.v1"}, "script_id": {"type": "string"}, "route_id": {"type": "string"}, "version": {"type": "integer", "minimum": 1},
        "duration_ms": {"type": "integer", "minimum": 1}, "hook_options": {"type": "array", "minItems": 3, "items": {"type": "string"}}, "chosen_hook": {"type": "string"},
        "segments": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["start_ms", "end_ms", "function", "spoken_line", "evidence_ids", "claim_label"]}},
        "full_script": {"type": "string", "minLength": 1}, "reading_speed_wpm": {"type": "number", "exclusiveMinimum": 0}, "cta": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1}, "cover_text": {"type": "string", "minLength": 1}, "caption": {"type": "string", "minLength": 1},
        "pinned_comment_strategy": {"type": "object"}, "platform_adaptations": {"type": "object", "required": ["instagram_reels", "tiktok", "youtube_shorts"]},
        "claim_map": {"type": "array", "minItems": 1}, "on_screen_text": {"type": "array"}, "approval_state": {"const": "OWNER_REVIEW_PENDING"}
      }, "additionalProperties": false
    },
    "shots": {
      "type": "object",
      "required": ["schema", "route_id", "duration_ms", "shots", "provider_execution"],
      "properties": {
        "schema": {"const": "m2.shot-manifest.v1"}, "route_id": {"type": "string"}, "duration_ms": {"type": "integer", "minimum": 1}, "provider_execution": {"const": "NOT_RUN"},
        "shots": {"type": "array", "minItems": 10, "maxItems": 16, "items": {"type": "object", "required": ["shot_id", "start_ms", "end_ms", "narrative_function", "spoken_line", "visual_objective", "visual", "framing", "motion", "screen_or_diagram_content", "on_screen_text", "source_ids", "evidence_ids", "asset_ids", "source_state", "generation_state", "deterministic", "transition", "audio", "audio_cue", "fallback", "qc"], "properties": {"generation_state": {"const": "NOT_RUN"}, "deterministic": {"const": true}}}}
      }, "additionalProperties": false
    },
    "assets": {
      "type": "object",
      "required": ["schema", "route_id", "assets", "private_media_state", "generated_media_state"],
      "properties": {
        "schema": {"const": "m2.asset-manifest.v1"}, "route_id": {"type": "string"}, "private_media_state": {"const": "BLOCKED_APPROVAL"}, "generated_media_state": {"const": "NOT_RUN"},
        "assets": {"type": "array", "items": {"type": "object", "required": ["asset_id", "asset_type", "path", "rights_state", "provider_state", "retention", "fallback"], "properties": {"provider_state": {"const": "NOT_RUN"}}}}
      }, "additionalProperties": false
    },
    "founder": {"type": "object", "required": ["schema", "route_id", "state", "takes", "reason"], "properties": {"schema": {"const": "m2.founder-shoot-manifest.v1"}, "route_id": {"type": "string"}, "state": {"const": "BLOCKED_APPROVAL"}, "takes": {"type": "array", "maxItems": 0}, "reason": {"type": "string"}}, "additionalProperties": false},
    "edit": {"type": "object", "required": ["schema", "route_id", "timeline_state", "duration_ms", "operations", "shots", "timeline", "track_plan", "marker_plan", "caption_plan", "audio_plan", "export_plan", "unsupported_operations", "resolve_mutation_state", "final_video_state"], "properties": {"schema": {"const": "m2.edit-manifest.v1"}, "route_id": {"type": "string"}, "timeline_state": {"const": "PLAN_ONLY"}, "duration_ms": {"type": "integer", "minimum": 1}, "operations": {"type": "array"}, "shots": {"type": "array"}, "timeline": {"type": "array", "minItems": 10, "maxItems": 16}, "track_plan": {"type": "object"}, "marker_plan": {"type": "array"}, "caption_plan": {"type": "array"}, "audio_plan": {"type": "object"}, "export_plan": {"type": "object"}, "unsupported_operations": {"type": "array"}, "resolve_mutation_state": {"const": "BLOCKED_APPROVAL"}, "final_video_state": {"const": "NOT_RUN"}}, "additionalProperties": false},
    "platform": {"type": "object", "required": ["schema", "route_id", "route_platforms", "central_thesis", "packages", "shared_full_script", "pinned_comment_strategy", "linkedin_state", "publication_state", "feedback_ingestion_state"], "properties": {"schema": {"const": "m2.platform-package.v1"}, "route_id": {"type": "string"}, "route_platforms": {"type": "array", "contains": {"const": "tiktok"}}, "central_thesis": {"type": "string"}, "packages": {"type": "object", "required": ["instagram_reels", "tiktok", "youtube_shorts"], "minProperties": 3, "maxProperties": 3}, "shared_full_script": {"type": "string"}, "pinned_comment_strategy": {"type": "object"}, "linkedin_state": {"const": "ROUTE_LISTED_NO_SHORT_FORM_PACKAGE"}, "publication_state": {"const": "BLOCKED_APPROVAL"}, "feedback_ingestion_state": {"const": "NOT_RUN"}}, "additionalProperties": false},
    "qc": {"type": "object", "required": ["schema", "route_id", "maker", "reviewer", "verdict", "checks"], "properties": {"schema": {"const": "m2.qc-report.v1"}, "route_id": {"type": "string"}, "maker": {"const": "RESP-M2-M1"}, "reviewer": {"type": "null"}, "verdict": {"const": "PENDING_INDEPENDENT_REVIEW"}, "checks": {"type": "object"}}, "additionalProperties": false}
  }
}
