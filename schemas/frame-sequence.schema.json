{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archflow.local/content-engine/frame-sequence.schema.json",
  "title": "FrameSequence",
  "type": "object",
  "required": ["sequence_id", "video_id", "target_duration_ms", "aspect_ratio", "frames", "storyboard_asset_state", "external_provider_generation_state", "owner_state", "review"],
  "properties": {
    "sequence_id": {"type": "string", "pattern": "^SEQ-[A-Z0-9-]+$"},
    "video_id": {"type": "string", "pattern": "^V(0[1-9]|1[0-5])$"},
    "target_duration_ms": {"type": "integer", "exclusiveMinimum": 15000, "maximum": 45000},
    "aspect_ratio": {"enum": ["9:16", "4:5", "1:1", "16:9"]},
    "frames": {
      "type": "array",
      "minItems": 8,
      "maxItems": 22,
      "items": {
        "type": "object",
        "required": ["frame_id", "sequence_number", "start_ms", "end_ms", "story_function", "composition_type", "base_plate_prompt", "overlay_asset_prompts", "combined_composite_description", "camera_and_motion", "narration", "on_screen_text", "transition_in", "transition_out", "music_cue", "sfx_cue", "continuity_ids", "negative_constraints", "fallback", "acceptance_checks"],
        "properties": {
          "frame_id": {"type": "string", "pattern": "^V(0[1-9]|1[0-5])-F[0-9]{2}$"},
          "sequence_number": {"type": "integer", "minimum": 1},
          "start_ms": {"type": "integer", "minimum": 0},
          "end_ms": {"type": "integer", "minimum": 1},
          "story_function": {"type": "string", "minLength": 1},
          "composition_type": {"enum": ["talking_head", "generated_scene", "screen_capture", "motion_graphic", "hybrid"]},
          "base_plate_prompt": {"type": "string"},
          "subject_plate_prompt": {"type": ["string", "null"]},
          "overlay_asset_prompts": {"type": "array", "items": {"type": "string"}},
          "combined_composite_description": {"type": "string", "minLength": 1},
          "camera_and_motion": {"type": "string", "minLength": 1},
          "narration": {"type": "string"},
          "on_screen_text": {"type": "string"},
          "transition_in": {"type": "string"},
          "transition_out": {"type": "string"},
          "music_cue": {"type": "string"},
          "sfx_cue": {"type": "string"},
          "continuity_ids": {"type": "array", "items": {"type": "string"}},
          "negative_constraints": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "fallback": {"type": "string"},
          "acceptance_checks": {"type": "array", "items": {"type": "string"}, "minItems": 1}
        },
        "allOf": [
          {
            "if": {"properties": {"composition_type": {"enum": ["talking_head", "hybrid"]}}, "required": ["composition_type"]},
            "then": {
              "required": ["subject_plate_prompt"],
              "properties": {"subject_plate_prompt": {"type": "string", "minLength": 1}}
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "contact_sheet_path": {"type": ["string", "null"]},
    "individual_frame_paths": {"type": "array", "items": {"type": "string"}},
    "storyboard_asset_state": {"enum": ["NOT_RUN", "DETERMINISTIC_LOCAL_READY", "LOCAL_CODEX_EXECUTED", "MIXED_LOCAL_READY"]},
    "external_provider_generation_state": {"const": "NOT_RUN"},
    "owner_state": {"enum": ["OWNER_REVIEW_PENDING", "REVISE", "APPROVED_FOR_NEXT_GATE"]},
    "review": {"type": "object", "required": ["maker", "reviewer", "verdict"], "properties": {"maker": {"type": "string"}, "reviewer": {"type": "string"}, "verdict": {"enum": ["PENDING", "APPROVE", "REVISE", "BLOCK"]}, "notes": {"type": ["string", "null"]}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
