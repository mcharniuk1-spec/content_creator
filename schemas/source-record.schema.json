{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archflow.local/content-engine/source-record.schema.json",
  "title": "SourceRecord",
  "type": "object",
  "required": [
    "record_id", "campaign_domain", "platform", "surface", "medium", "canonical_url",
    "checked_at", "discovery_route", "collector_backend", "authentication_class", "access_state",
    "source_grade", "claim_label", "rights_state", "clean_room_state", "analysis_status"
  ],
  "properties": {
    "record_id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
    "campaign_domain": {"enum": ["archflow_onboarding", "hotel_revenue"]},
    "platform": {"enum": ["linkedin", "x", "threads", "instagram", "youtube", "tiktok", "reddit", "facebook", "github", "web", "rss", "meta_ad_library", "linkedin_ad_library", "publication_library"]},
    "surface": {"enum": ["post", "thread", "article", "reel", "short", "video", "carousel", "static", "ad", "report", "newsletter", "repository", "issue", "discussion"]},
    "medium": {"enum": ["text", "image", "carousel", "video", "audio", "mixed", "screen_recording"]},
    "canonical_url": {"type": "string", "format": "uri", "pattern": "^https://"},
    "parent_url": {"type": ["string", "null"], "format": "uri"},
    "public_native_id": {"type": ["string", "null"]},
    "publisher_type": {"enum": ["official", "company", "creator", "practitioner", "publication", "community", "unknown"]},
    "publisher_name": {"type": ["string", "null"]},
    "published_at": {"type": ["string", "null"], "format": "date-time"},
    "checked_at": {"type": "string", "format": "date-time"},
    "language": {"type": ["string", "null"]},
    "region": {"type": ["string", "null"]},
    "duration_ms": {"type": ["integer", "null"], "minimum": 0},
    "dimensions": {"type": ["string", "null"]},
    "aspect_ratio": {"type": ["string", "null"]},
    "discovery_query": {"type": ["string", "null"]},
    "discovery_route": {"type": "string", "minLength": 1},
    "collector_backend": {"type": "string", "minLength": 1},
    "authentication_class": {"enum": ["none", "existing_user_session", "owner_export", "unverified"]},
    "access_state": {"enum": ["discovered", "native_readable", "metadata_only", "snippet_only", "blocked"]},
    "transcript_state": {"enum": ["native", "auto_caption", "asr", "unavailable", "not_applicable"]},
    "metrics_state": {"enum": ["official_public", "owner_export", "visible_snapshot", "unavailable"]},
    "topic_cluster": {"type": ["string", "null"]},
    "buyer": {"type": ["string", "null"]},
    "forcing_moment": {"type": ["string", "null"]},
    "pain": {"type": ["string", "null"]},
    "promise": {"type": ["string", "null"]},
    "mechanism": {"type": ["string", "null"]},
    "proof_type": {"type": ["string", "null"]},
    "cta_type": {"type": ["string", "null"]},
    "hook_pattern": {"type": ["string", "null"]},
    "narrative_pattern": {"type": ["string", "null"]},
    "visual_pattern": {"type": ["string", "null"]},
    "audio_pattern": {"type": ["string", "null"]},
    "overlay_pattern": {"type": ["string", "null"]},
    "pacing_class": {"type": ["string", "null"]},
    "source_grade": {"enum": ["primary", "first_party_claim", "practitioner_signal", "routing_hint"]},
    "claim_label": {"enum": ["FACT", "INTERPRETATION", "HYPOTHESIS", "GAP"]},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "rights_state": {"enum": ["facts_only", "commentary_allowed", "permission_required", "blocked", "unknown"]},
    "clean_room_state": {"enum": ["pending", "abstracted", "similarity_pass", "blocked"]},
    "dedup_key": {"type": "string", "minLength": 1},
    "near_duplicate_cluster_id": {"type": ["string", "null"]},
    "analysis_status": {"enum": ["discovered", "normalized", "analyzed", "corroborated", "rejected", "blocked", "stale"]},
    "analysis_paths": {"type": "array", "items": {"type": "string"}},
    "block_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
