{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archflow.local/content-engine/analysis-finding.schema.json",
  "title": "AnalysisFinding",
  "type": "object",
  "required": ["finding_id", "evidence_card_ids", "finding_type", "statement", "scope", "limitations", "confidence", "contradiction_state", "maker", "review"],
  "properties": {
    "finding_id": {"type": "string", "pattern": "^FIND-[A-Z0-9-]+$"},
    "evidence_card_ids": {"type": "array", "items": {"type": "string", "pattern": "^EV-[A-Z0-9-]+$"}, "minItems": 1, "uniqueItems": true},
    "finding_type": {"enum": ["FACT", "INTERPRETATION", "HYPOTHESIS", "GAP"]},
    "statement": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "contradiction_state": {"enum": ["none_observed", "corroborated", "unresolved", "superseded"]},
    "maker": {"type": "string", "minLength": 1},
    "review": {"type": "object", "required": ["reviewer", "verdict"], "properties": {"reviewer": {"type": "string"}, "verdict": {"enum": ["PENDING", "APPROVE", "REVISE", "BLOCK"]}, "notes": {"type": ["string", "null"]}}, "additionalProperties": false}
  },
  "additionalProperties": false
}
