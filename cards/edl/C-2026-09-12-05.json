 "captions": [
  {
   "from_frame": 0,
   "duration_frames": 150,
   "text": "We wrote a mandatory check into our own process on the first of September."
  },
  {
   "from_frame": 150,
   "duration_frames": 69,
   "text": "Here is the box. Empty."
  },
  {
   "from_frame": 219,
   "duration_frames": 300,
   "text": "You have one too. Somewhere in your process a document says a person checks this before it goes out. Now find where that check is recorded."
  },
  {
   "from_frame": 519,
   "duration_frames": 312,
   "text": "Ours is a single column. It has been there since the rule was written. It is filled in on four rows out of two hundred and eighty-two."
  },
  {
   "from_frame": 831,
   "duration_frames": 345,
   "text": "All four were filled on the same day, the day we wrote the rule. Every card we have drafted since has a row waiting and the box behind it empty."
  },
  {
   "from_frame": 1176,
   "duration_frames": 312,
   "text": "Three items on this week's shortlist should have failed that check. We caught them by reading. One of the three is in the record. Two are not."
  },
  {
   "from_frame": 1488,
   "duration_frames": 336,
   "text": "A check nothing stops for is a preference. Three ways out: make the step block, put it where someone already looks, or delete the rule. We took the first."
  },
  {
   "from_frame": 1824,
   "duration_frames": 231,
   "text": "Open where your process says the check is recorded and count the last fifty. Send this to whoever signs off."
  }
 ],
