 "captions": [
  {
   "from_frame": 0,
   "duration_frames": 240,
   "text": "Watch an enquiry go from the inbox to the sheet to the calendar. Each name is where a tool stops."
  },
  {
   "from_frame": 240,
   "duration_frames": 324,
   "text": "Nothing clever happens here. It reads the inbox, writes a row in the sheet, puts a slot in the calendar. Three names to check before you pay."
  },
  {
   "from_frame": 564,
   "duration_frames": 228,
   "text": "Our own weekly run is a chain like that. Six named places. On Thursday two of them refused us."
  },
  {
   "from_frame": 792,
   "duration_frames": 384,
   "text": "One source went quiet five times in a row, so none of the hundred and thirty profiles updated. And the notes tool said the same thing three times: cannot find the database."
  },
  {
   "from_frame": 1176,
   "duration_frames": 300,
   "text": "Three days earlier that same connection worked. Someone moved the destination and the tool lost it. The one place nobody moved saved everything, first time."
  },
  {
   "from_frame": 1476,
   "duration_frames": 360,
   "text": "Supported is not the same as connected, and connected is not the same as still connected. Write down the three systems your work lives in and check them by name."
  },
  {
   "from_frame": 1836,
   "duration_frames": 204,
   "text": "Where a name is missing, that step stays manual. Send this to whoever is picking the tool."
  }
 ],
