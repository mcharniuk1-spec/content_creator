  "captions": [
    {
      "duration_frames": 120,
      "from_frame": 0,
      "text": "A tool demo is a reason to test, not switch."
    },
    {
      "duration_frames": 210,
      "from_frame": 120,
      "text": "Suppose your repeated task is turning weekly notes into an update. Keep one fictional input ready."
    },
    {
      "duration_frames": 210,
      "from_frame": 330,
      "text": "Run that same input through a candidate tool using the same instructions and required output."
    },
    {
      "duration_frames": 210,
      "from_frame": 540,
      "text": "Check three things: did it preserve the facts, show missing information, and leave an editable draft?"
    },
    {
      "duration_frames": 210,
      "from_frame": 750,
      "text": "Record the result beside the tool version and the date. Include the part that failed."
    },
    {
      "duration_frames": 180,
      "from_frame": 960,
      "text": "A polished answer is not the whole test. Someone still has to review and maintain the workflow."
    },
    {
      "duration_frames": 180,
      "from_frame": 1140,
      "text": "If it misses a requirement, adjust the task or reject this candidate. You do not need to switch."
    },
    {
      "duration_frames": 180,
      "from_frame": 1320,
      "text": "Keep one example and one checklist. Use them for your next tool evaluation."
    }
  ],
