  "captions": [
    {
      "duration_frames": 120,
      "from_frame": 0,
      "text": "We gave this workflow a draft it should reject."
    },
    {
      "duration_frames": 210,
      "from_frame": 120,
      "text": "It is a small local test, using a fictional meeting note and a deliberately faulty action list."
    },
    {
      "duration_frames": 210,
      "from_frame": 330,
      "text": "The draft adds an owner and a deadline that the source never supplied."
    },
    {
      "duration_frames": 210,
      "from_frame": 540,
      "text": "Our check flags both fields and changes the result to needs human review. It does not send anything."
    },
    {
      "duration_frames": 210,
      "from_frame": 750,
      "text": "The useful part is the reason: these details are unsupported. The process owner can now resolve them."
    },
    {
      "duration_frames": 180,
      "from_frame": 960,
      "text": "After a correction, check again. Do not hide the failure by calling the original output finished."
    },
    {
      "duration_frames": 180,
      "from_frame": 1140,
      "text": "This catches the two problems in our fixture. It is not a test of every possible AI error."
    },
    {
      "duration_frames": 180,
      "from_frame": 1320,
      "text": "Pick one missing-input case in your workflow. Decide who sees it and what happens next."
    }
  ],
