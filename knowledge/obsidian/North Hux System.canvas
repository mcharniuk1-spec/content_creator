    {"id":"nh-production","type":"text","x":1000,"y":420,"width":340,"height":220,"text":"# Current release\n\n10 scripts → 100 shots → 10 edit plans\n\nCreator A-roll + deterministic proof\nOptional AI context never carries evidence.","color":"3"},
    {"id":"nh-db","type":"text","x":0,"y":860,"width":420,"height":240,"text":"# Evidence authority\n\nLocal PostgreSQL + run artifacts\n47,266 hashed files\n12/12 restored table counts\nTerminal receipt v1\n\nRaw corpus stays outside Obsidian.","color":"4"},
    {"id":"nh-obsidian","type":"file","x":510,"y":860,"width":400,"height":240,"file":"knowledge/obsidian-wikillm-setup.md","color":"6"},
    {"id":"nh-gates","type":"text","x":1000,"y":860,"width":340,"height":240,"text":"# Owner gates\n\nApprove scripts and first 3 episodes\nApprove proof UI and optional AI context\nRecord A-roll\nSeparately approve providers, editing, and publication\nApprove exact external-vault correction files","color":"1"}
