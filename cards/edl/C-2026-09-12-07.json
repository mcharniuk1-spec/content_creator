 "captions": [
  {
   "from_frame": 0,
   "duration_frames": 228,
   "text": "Fourteen times normal. One point nine times normal. Same item, same week. The first one went into the plan."
  },
  {
   "from_frame": 228,
   "duration_frames": 288,
   "text": "Think of two receipts for the same job with different totals. Both correct. Added up differently. You quote a number like that every month."
  },
  {
   "from_frame": 516,
   "duration_frames": 264,
   "text": "We hold twelve of this person's videos. Six under twenty thousand views. Six over two hundred and eighty thousand. Nothing in between."
  },
  {
   "from_frame": 780,
   "duration_frames": 372,
   "text": "Normal is the middle one. Leave this video out and the middle is nineteen thousand. Leave it in and the middle falls in the gap, at a hundred and fifty thousand."
  },
  {
   "from_frame": 1152,
   "duration_frames": 288,
   "text": "Neither number is wrong. Same twelve videos, both times. Nobody checked which one the decision needed, and the video is ordinary for this author."
  },
  {
   "from_frame": 1440,
   "duration_frames": 372,
   "text": "A number is not a fact. It is the answer to a question, and the question has to travel with it. One definition, written down once, carried everywhere the number goes."
  },
  {
   "from_frame": 1812,
   "duration_frames": 264,
   "text": "The one-page definition sheet is in the caption. Take the figure you quote most, find the second place it is worked out."
  }
 ],
