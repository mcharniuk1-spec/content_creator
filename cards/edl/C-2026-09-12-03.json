 "captions": [
  {
   "from_frame": 0,
   "duration_frames": 225,
   "text": "This step has never failed. We turned it off this week. Here is the number that decided it."
  },
  {
   "from_frame": 225,
   "duration_frames": 300,
   "text": "You have one of these. A script, a mailbox rule, something set up months ago. It still runs. Nobody has asked what it changes."
  },
  {
   "from_frame": 525,
   "duration_frames": 312,
   "text": "Ours matched what is said in a video to where the picture changes. It ran on two hundred and sixty-four videos. It never crashed once."
  },
  {
   "from_frame": 837,
   "duration_frames": 201,
   "text": "Out of one thousand five hundred and twenty-seven places it could have matched, it found fifty-five."
  },
  {
   "from_frame": 1038,
   "duration_frames": 426,
   "text": "Two hundred and fifteen videos gave it nothing at all. Some of that is our own measurement being coarse. And the videos it matched came out no different from the ones it did not."
  },
  {
   "from_frame": 1464,
   "duration_frames": 375,
   "text": "So it is off. Every automation now gets two things written down the day it is built: the number that proves it is worth keeping, and the date we check."
  },
  {
   "from_frame": 1839,
   "duration_frames": 249,
   "text": "The checklist is in the caption. Find the one that fired least last month, then keep it or kill it."
  }
 ],
