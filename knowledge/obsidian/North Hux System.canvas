    {"id":"nh-two-tracks","type":"text","x":0,"y":420,"width":420,"height":220,"text":"# Two creator tracks\n\nA — PM integration, workflow diagnosis, adoption, value\n\nB — authority, evidence, evaluation, recovery, governance","color":"2"},
