  "captions": [
    {
      "duration_frames": 120,
      "from_frame": 0,
      "text": "A neat meeting summary can still invent the next step."
    },
    {
      "duration_frames": 210,
      "from_frame": 120,
      "text": "Here is a made-up meeting note: check the room. Nobody has agreed who will do it."
    },
    {
      "duration_frames": 210,
      "from_frame": 330,
      "text": "This deliberately faulty draft assigns a person and a deadline. Neither appears in the note."
    },
    {
      "duration_frames": 210,
      "from_frame": 540,
      "text": "Ask for three fields: action, owner, and due date. Missing information should stay visibly unknown."
    },
    {
      "duration_frames": 210,
      "from_frame": 750,
      "text": "Then compare each row with the original note. AI prepares the draft; the meeting owner checks it."
    },
    {
      "duration_frames": 180,
      "from_frame": 960,
      "text": "If ownership is missing, ask the team. Do not let a tidy table make the decision."
    },
    {
      "duration_frames": 180,
      "from_frame": 1140,
      "text": "Only the confirmed version becomes the action list. Keep the source note beside it."
    },
    {
      "duration_frames": 180,
      "from_frame": 1320,
      "text": "Try this on a fictional note first: can you spot what was never agreed?"
    }
  ],
