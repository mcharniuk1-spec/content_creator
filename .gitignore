# Секреты — ни при каких условиях
.env
.env.*
!.env.example

# Оплаченные ответы API и подписанные ссылки Instagram — наружу не уходят
cache/
cache-free/
cache-free-full/
hiker-cache/

# База и рабочие данные: там биографии кандидатов и кадры чужих роликов
data/
archive/

# Сборка отчётов: генерируемые страницы недели в репозиторий не идут,
# аудит идёт — это документ, а не вывод прогона
*.html
!audit.html

__pycache__/
*.pyc
.DS_Store

# Shared-engine private runtime boundary
.local/
private-runs/
node_modules/
*.sqlite
*.sqlite-*
*.db
*.db-*
*.mp4
*.mov
*.webm
*.wav
*.m4a
*.mp3
*.partial
