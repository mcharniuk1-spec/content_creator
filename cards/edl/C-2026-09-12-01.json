 "captions": [
  {
   "from_frame": 0,
   "duration_frames": 240,
   "text": "This is the list our system put at the top. Nineteen of the top twenty are there on a trick."
  },
  {
   "from_frame": 240,
   "duration_frames": 336,
   "text": "You work from a list like this. Something decides which enquiry, which ticket, which invoice gets looked at first, and nobody has re-read the rule that sorts it."
  },
  {
   "from_frame": 576,
   "duration_frames": 72,
   "text": "Ours sorted by forwards and saves."
  },
  {
   "from_frame": 648,
   "duration_frames": 348,
   "text": "Ask people to comment a word under a post and its saves go up nearly three times, its forwards nearly double, and its reach does not move at all."
  },
  {
   "from_frame": 996,
   "duration_frames": 144,
   "text": "So we sorted the same list again, comparing only like with like."
  },
  {
   "from_frame": 1140,
   "duration_frames": 384,
   "text": "Eight of the top twenty are now posts that never asked for a comment. Two of them had been sixty-seventh and sixty-first. Nothing about them changed. Only what we divided by did."
  },
  {
   "from_frame": 1524,
   "duration_frames": 300,
   "text": "The rule we added: record the habit on every item, and only compare items that share it. A ranking measures exactly what you feed it."
  },
  {
   "from_frame": 1824,
   "duration_frames": 228,
   "text": "Find what your top five have in common that is not importance. Send this to whoever owns that list."
  }
 ],
