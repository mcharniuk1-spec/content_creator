{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archflow.local/content-engine/source-manifest.schema.json",
  "title": "SourceManifest",
  "type": "object",
  "required": ["manifest_id", "observed_at", "sources"],
  "properties": {
    "$schema": {"type": "string"},
    "manifest_id": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "name", "source_class", "status", "verified_facts", "allowed_now", "blocked_now"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]+$"},
          "name": {"type": "string", "minLength": 1},
          "canonical_url": {"type": "string"},
          "pinned_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "source_class": {"type": "string", "minLength": 1},
          "license": {"type": "string"},
          "status": {"enum": ["reference_only", "placeholder_empty", "bounded_context_only", "approved_runtime", "blocked"]},
          "verified_facts": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "allowed_now": {"type": "array", "items": {"type": "string"}},
          "blocked_now": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "review_required": {"type": "array", "items": {"type": "string"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}

