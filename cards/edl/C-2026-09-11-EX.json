  "audio_stems": [],
  "captions": [
    {
      "duration_frames": 120,
      "from_frame": 0,
      "text": "Our own ranking script put a 654-view reel above a 25,000-view one. Here is why."
    },
    {
      "duration_frames": 180,
      "from_frame": 120,
      "text": "Every Monday our ranker reads the week's eligible reels and writes a shot plan automatically, no human in the loop yet."
    },
    {
      "duration_frames": 300,
      "from_frame": 300,
      "text": "It ranks by save-rate per thousand views, not by raw views, so a small reel with a high ratio can outrank a much bigger one."
    },
    {
      "duration_frames": 360,
      "from_frame": 600,
      "text": "That is fine when both reels have enough views to trust the ratio. It breaks when one of them barely has any."
    },
    {
      "duration_frames": 390,
      "from_frame": 960,
      "text": "This week it picked a 654-view reel over one with 25,000 views, because the small one had a slightly higher save-rate."
    },
    {
      "duration_frames": 240,
      "from_frame": 1350,
      "text": "We are adding a minimum-view floor before the save-rate sort even runs, so a tiny sample can't win on ratio alone."
    },
    {
      "duration_frames": 210,
      "from_frame": 1590,
      "text": "We are testing the fix next week and will say here if it held."
    }
  ],
